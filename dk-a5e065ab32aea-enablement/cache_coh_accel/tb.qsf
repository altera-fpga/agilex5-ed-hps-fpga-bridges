# Quartus version assignments
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 24.3.0
set_global_assignment -name LAST_QUARTUS_VERSION "26.1.0 Pro Edition"

# Device properties
set_global_assignment -name FAMILY "Agilex 5"
# SM7+ board
set_global_assignment -name DEVICE A5ED065AB32AE1V

# Toplevel and toplevel RTL
set_global_assignment -name TOP_LEVEL_ENTITY tb

# Flow assignments
# Put all reports into the output_files directory
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
# Set the default parallelization to 4
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
# Define the board as default
# Convert timing failures to errors
# Include custom IP in IP search path
set_global_assignment -name IP_SEARCH_PATHS "custom_ip/**/*; ip/cca_fab_accel/**/*; ip/shell_subsys/**/*"
# Disable assembler during "play button" flow
set_global_assignment -name FLOW_DISABLE_ASSEMBLER OFF
# Disable spawning the Timing Analyzer GUI during the "play button" flow
set_global_assignment -name FLOW_ENABLE_INTERACTIVE_TIMING_ANALYZER ON
# Promote pins without location assignments to errors
set_global_assignment -name PROMOTE_WARNING_TO_ERROR 12677
# Promote timing failures to errors:
set_global_assignment -name PROMOTE_WARNING_TO_ERROR 332148

# compile assignments
set_global_assignment -name BOARD default
set_global_assignment -name FLOW_ENABLE_HYPER_RETIMER_FAST_FORWARD ON
set_global_assignment -name REMOVE_DUPLICATE_REGISTERS OFF
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION OFF
set_global_assignment -name POWER_APPLY_THERMAL_MARGIN ADDITIONAL

# Configuration Assignments
set_global_assignment -name HPS_DAP_NO_CERTIFICATE on
set_global_assignment -name QSPI_OWNERSHIP HPS
set_global_assignment -name ENABLE_INTERMEDIATE_SNAPSHOTS ON
set_global_assignment -name USE_HPS_COLD_RESET SDM_IO11
set_global_assignment -name USE_CONF_DONE SDM_IO12
set_global_assignment -name HPS_INITIALIZATION "AFTER INIT_DONE"
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ
set_global_assignment -name HPS_DAP_SPLIT_MODE "SDM PINS"
set_global_assignment -name PWRMGT_BUS_SPEED_MODE "400 KHZ"
set_global_assignment -name PWRMGT_PAGE_COMMAND_ENABLE ON
set_global_assignment -name PWRMGT_SLAVE_DEVICE_TYPE OTHER
set_global_assignment -name PWRMGT_SLAVE_DEVICE0_ADDRESS 74
set_global_assignment -name PWRMGT_SLAVE_DEVICE1_ADDRESS 75
set_global_assignment -name PWRMGT_SLAVE_DEVICE2_ADDRESS 00
set_global_assignment -name PWRMGT_SLAVE_DEVICE3_ADDRESS 00
set_global_assignment -name PWRMGT_SLAVE_DEVICE4_ADDRESS 00
set_global_assignment -name PWRMGT_SLAVE_DEVICE5_ADDRESS 00
set_global_assignment -name PWRMGT_SLAVE_DEVICE6_ADDRESS 00
set_global_assignment -name PWRMGT_SLAVE_DEVICE7_ADDRESS 00
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
set_global_assignment -name PWRMGT_TRANSLATED_VOLTAGE_VALUE_UNIT VOLTS
set_global_assignment -name USE_CHECKSUM_AS_USERCODE OFF
set_global_assignment -name NUMBER_OF_SLAVE_DEVICE 2

# Variant IP source files
set_global_assignment -name IP_FILE ip/cache_coh_accel_subsys/cache_coh_accel_subsys_reset_bridge_0.ip
set_global_assignment -name IP_FILE ip/cache_coh_accel_subsys/cache_coh_accel_subsys_clock_bridge_0.ip
set_global_assignment -name IP_FILE ip/cache_coh_accel_subsys/cache_coh_accel_subsys_msgdma_1.ip
set_global_assignment -name IP_FILE ip/cache_coh_accel_subsys/cache_coh_accel_subsys_msgdma_0.ip
set_global_assignment -name IP_FILE ip/cache_coh_accel_subsys/cache_coh_accel_subsys_mm_bridge_0.ip
set_global_assignment -name IP_FILE ip/cache_coh_accel_subsys/cache_coh_accel_subsys_intel_onchip_memory_0.ip
set_global_assignment -name IP_FILE ip/cache_coh_accel_subsys/cache_coh_accel_subsys_fpga2hps_msgdma2axi4.ip
set_global_assignment -name IP_FILE ip/cache_coh_accel_subsys/cache_coh_accel_subsys_cca_accel_top_0.ip
set_global_assignment -name QSYS_FILE cache_coh_accel_subsys.qsys
set_global_assignment -name IP_FILE ip/tb/tb_clock_in.ip
set_global_assignment -name IP_FILE ip/tb/tb_reset_in.ip
set_global_assignment -name IP_FILE ip/tb/tb_intel_niosv_m_0.ip
set_global_assignment -name IP_FILE ip/tb/tb_intel_onchip_memory_0.ip
set_global_assignment -name IP_FILE ip/tb/tb_jtag_uart_0.ip
set_global_assignment -name IP_FILE ip/tb/tb_gpo_0.ip
set_global_assignment -name IP_FILE ip/tb/tb_gpi_0.ip
set_global_assignment -name IP_FILE ip/tb/tb_intel_onchip_memory_1.ip
set_global_assignment -name QSYS_FILE tb.qsys
set_global_assignment -name QSYS_FILE cache_coh_top.qsys

# Variant RTL source files
set_global_assignment -name SYSTEMVERILOG_FILE src/fpga2hps_msgdma2axi4.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/cca_accel_csr.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/cca_accel_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/cca_accel_top.sv
