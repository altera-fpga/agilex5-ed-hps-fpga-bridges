::drc::add_waiver \
	-description {LWH2F, F2H, and F2SDRAM already have one domain-entry reset synchronizer (fpga_reset_n_sync_*). Extra chains are generated by PMON IP, dual-clock interconnect FIFO reset syncs, and Qsys reset controllers and cannot be collapsed to a single chain per clock.} \
	-rule_id {RDC-50003} \
	-query_string {"Reset Clock Domain" =~ '.*u_sys_pll\|iopll_0_outclk[234]'} \
	-stages {{Timing Signoff}} \
	-tag {} \
	-timestamp {2026-08-27*10:00:00} \
	-owner {user} \
	-no_warn